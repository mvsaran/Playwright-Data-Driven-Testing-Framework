# ── Application URL ────────────────────────────────────────────────────────
# Override to run the suite against a different environment.
# Default (when not set): https://www.saucedemo.com
BASE_URL=https://www.saucedemo.com

# ── Test Data Source ────────────────────────────────────────────────────────
# Controls which file format the framework reads test cases from.
#
# Supported values:
#   json        (default) test-data/login-data.json
#   csv                   test-data/login-data.csv
#   yaml                  test-data/login-data.yaml
#   properties            test-data/login-data.properties
#   excel                 test-data/login-data.xlsx
#                         (generate with: npx tsx scripts/generateExcelData.ts)
#
# PowerShell:  $env:DATA_SOURCE = "yaml" ; npm test
# Bash / CI:   DATA_SOURCE=yaml npm test
DATA_SOURCE=json
